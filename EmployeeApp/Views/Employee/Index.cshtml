@model IEnumerable<Employee>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Employee List</h3>
        <a href="/Employee/Create" class="btn btn-success">+ Add Employee</a>
    </div>

    <table class="table table-bordered table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>DOB</th>
                <th>Email</th>
                <th>Phone</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.DOB.ToShortDateString()</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>
                        <a href="/Employee/Edit/@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a href="/Employee/Delete/@item.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>