@model Employee

<h2>Add Employee</h2>

<form asp-action="Create" method="post">

    <div>
        <input asp-for="FirstName" placeholder="First Name" />
        <span asp-validation-for="FirstName" style="color:red"></span>
    </div>

    <div>
        <input asp-for="LastName" placeholder="Last Name" />
        <span asp-validation-for="LastName" style="color:red"></span>
    </div>

    <div>
        <input asp-for="DOB" type="date" />
        <span asp-validation-for="DOB" style="color:red"></span>
    </div>

    <div>
        <input asp-for="Country" placeholder="Country" />
        <span asp-validation-for="Country" style="color:red"></span>
    </div>

    <div>
        <input asp-for="State" placeholder="State" />
        <span asp-validation-for="State" style="color:red"></span>
    </div>

    <div>
        <input asp-for="City" placeholder="City" />
        <span asp-validation-for="City" style="color:red"></span>
    </div>

    <div>
        <input asp-for="Qualification" placeholder="Qualification" />
        <span asp-validation-for="Qualification" style="color:red"></span>
    </div>

    <div>
        <input asp-for="Email" placeholder="Email" />
        <span asp-validation-for="Email" style="color:red"></span>
    </div>

    <div>
        <input asp-for="Phone" placeholder="Phone" />
        <span asp-validation-for="Phone" style="color:red"></span>
    </div>

    <button type="submit">Save</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}